# Runtime mode: development | production
MAGIC_RENDER_ENV=development

# Electron dev server URL. Only used during development.
MAGIC_RENDER_DEV_SERVER_URL=http://127.0.0.1:5173

# Optional custom FFmpeg executable path. In packaged Windows builds,
# the default resolves to resources/ffmpeg/ffmpeg.exe.
MAGIC_RENDER_FFMPEG_PATH=

# Optional future-facing environment values should remain Main-process only.

# Optional custom ffprobe executable path. Usually resides next to ffmpeg.exe.
MAGIC_RENDER_FFPROBE_PATH=
